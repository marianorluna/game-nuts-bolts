{
  "name": "nuts-and-bolts",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.6.0",
  "versionCode": 11,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sync:version": "npx tsx scripts/sync-android-version.ts",
    "cap:sync": "npm run sync:version && npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "validate:levels": "npx tsx scripts/validate-levels.ts",
    "validate:locales": "npx tsx scripts/validate-locales.ts",
    "changelog:sync": "npx tsx scripts/sync-changelog.ts sync",
    "changelog:check": "npx tsx scripts/sync-changelog.ts check",
    "changelog:scaffold": "npx tsx scripts/sync-changelog.ts scaffold",
    "release:prepare": "npm run changelog:check && npm run changelog:sync && npm run sync:version",
    "bake:levels": "npx tsx scripts/bake-levels.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:supabase": "npx tsx scripts/test-supabase.ts",
    "generate:icons": "python scripts/generate-icons-from-splash.py && npx @capacitor/assets generate --android --iconBackgroundColor \"#2d1b4e\""
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capawesome/capacitor-app-update": "^8.0.3",
    "@supabase/supabase-js": "^2.110.0",
    "framer-motion": "^12.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
