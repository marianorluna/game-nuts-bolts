# Copia a .env.local para activar en desarrollo (gitignored).

# Desbloquea todos los niveles y permite navegar entre todas las etapas.
VITE_UNLOCK_ALL_LEVELS=true

# Muestra todas las medallas con su diseño completo en el medallero (solo dev).
VITE_PREVIEW_ALL_MEDALS=true

# Supabase (Prompt 1+) — obtener en Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GAME_ID=nuts-and-bolts

# Feature flags (Prompt 2+)
VITE_FEATURE_CLOUD_SYNC=true
VITE_FEATURE_LEADERBOARD=true
